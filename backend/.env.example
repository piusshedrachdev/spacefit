# SpaceFit backend configuration
# Copy to .env and adjust as needed.

PORT=4000
NODE_ENV=development

# Comma separated list of allowed CORS origins, or * for all.
CORS_ORIGIN=*

# Currency
CURRENCY=NGN
CURRENCY_SYMBOL=₦

# Delivery pricing (in the storefront's base currency unit)
DELIVERY_FEE=15000
FREE_DELIVERY_THRESHOLD=500000

# VAT rate as a decimal (0.075 = 7.5%). Set to 0 to disable.
VAT_RATE=0.075

# Cities shown as serviceable in the checkout dropdown
SERVICEABLE_CITIES=Lagos,Abuja,Ibadan
