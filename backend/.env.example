PORT=4000
NODE_ENV=development
CORS_ORIGIN=*
CURRENCY=NGN
CURRENCY_SYMBOL=₦
DELIVERY_FEE=15000
FREE_DELIVERY_THRESHOLD=500000
VAT_RATE=0.075
SERVICEABLE_CITIES=Lagos,Abuja,Ibadan

# ---------------------------------------------------------------- Supabase
# Set USE_SUPABASE=true to serve data from Supabase PostgreSQL instead of the
# in-memory store. If credentials are missing the app falls back to memory.
USE_SUPABASE=false

# Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project.supabase.co

# Publishable (or legacy anon) key. Safe to expose in browser code.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# SECRET. Bypasses RLS. Server-only. Never commit the real value or ship it
# to a browser bundle. Also accepted as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=your-secret-key
