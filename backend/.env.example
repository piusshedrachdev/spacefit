# SpaceFit backend environment
# Copy to .env and fill in. All values have sensible defaults except Supabase.

PORT=4000
NODE_ENV=development
# CORS_ORIGIN=http://localhost:4000
CURRENCY=NGN
CURRENCY_SYMBOL=₦
DELIVERY_FEE=15000
FREE_DELIVERY_THRESHOLD=500000
VAT_RATE=0.075
SERVICEABLE_CITIES=Lagos,Abuja,Ibadan

# Serve the storefront from ../frontend (default) — override if needed.
# FRONTEND_DIR=

# --- Supabase (required for real auth + persistence) ---
# Without these the API falls back to the in-memory store and a built-in
# development login system (see README "Demo accounts").
USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Brevo transactional email (optional) ---
# Without an API key, emails are logged to the console instead of sent.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@spacefit.ng
BREVO_SENDER_NAME=SpaceFit
